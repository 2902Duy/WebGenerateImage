@page
@model ProfileModel
@{
    ViewData["Title"] = "Hồ sơ người dùng";
}

<h2>@ViewData["Title"]</h2>

@if (!string.IsNullOrEmpty(ViewData["Message"]?.ToString()))
{
    <div class="alert alert-success">@ViewData["Message"]</div>
}
@if (!string.IsNullOrEmpty(ViewData["Error"]?.ToString()))
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}

<form method="post">
    <div class="mb-3">
        <label>Email:</label>
        <input class="form-control" value="@Model.Email" readonly />
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsFaceVerified" class="form-check-input" type="checkbox" id="faceAuthCheck" />
        <label class="form-check-label" for="faceAuthCheck">Bật xác thực khuôn mặt</label>
    </div>

    <button type="submit" class="btn btn-success">Lưu thay đổi</button>
</form>
