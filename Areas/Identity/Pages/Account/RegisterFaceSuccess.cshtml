@page
@model RegisterFaceSuccessModel
@{
    ViewData["Title"] = "Đăng ký khuôn mặt thành công";
}

<section class="d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="card bg-dark text-white shadow-lg" style="max-width: 400px; width: 100%;">
        <div class="card-body text-center p-5">
            <div class="mb-4">
                <i class="bi bi-emoji-smile display-1 text-success"></i>
            </div>
            <h2 class="card-title text-success mb-3">Đăng ký khuôn mặt thành công!</h2>
            <p class="card-text mb-4">
                Cảm ơn bạn đã hoàn tất quá trình đăng ký khuôn mặt. Giờ bạn có thể sử dụng tính năng nhận diện để đăng nhập nhanh chóng.
            </p>
            <a href="/" class="btn btn-success px-4 py-2 fw-semibold">
                Quay về trang chủ
            </a>
        </div>
    </div>
</section>
