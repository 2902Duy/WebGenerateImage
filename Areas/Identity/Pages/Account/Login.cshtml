@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
    .login-form {
        max-width: 400px;
        background: rgba(0,0,0,0.6);
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.5);
    }

        .login-form .form-control {
            background: transparent;
            color: #fff;
            border: 1px solid #17c3b2;
            border-radius: 50px;
        }

            .login-form .form-control::placeholder {
                color: rgba(255,255,255,0.6);
            }

        .login-form .form-floating label {
            color: rgba(255,255,255,0.6);
        }

        .login-form .btn-primary {
            background: #17c3b2;
            border-color: #17c3b2;
            border-radius: 50px;
            padding: 0.75rem;
            color: #000;
        }

            .login-form .btn-primary:hover {
                background: #13a79e;
            }

        .login-form .alert-danger {
            background: rgba(255,0,0,0.1);
            border: 1px solid rgba(255,0,0,0.5);
            color: #f88;
        }

    .login-separator {
        width: 1px;
        background: rgba(255,255,255,0.2);
        margin: 0 1.5rem;
    }
</style>

<h1 class="text-white text-center mb-4">@ViewData["Title"]</h1>

<div class="d-flex justify-content-center align-items-start gap-4">

    <!-- Form Đăng nhập -->
    <div class="login-form">
        <form id="account" method="post" novalidate>
            <h4 class="text-white text-center mb-3">Sử dụng tài khoản đăng nhập</h4>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Password" />
                <label asp-for="Input.Password">Mật khẩu</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Input.RememberMe"
                       class="form-check-input"
                       id="rememberMeCheck" />
                <label class="form-check-label text-white" for="rememberMeCheck">
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>

            <button id="login-submit"
                    type="submit"
                    class="btn btn-primary w-100 mb-3">
                Đăng nhập
            </button>

            <div class="d-flex justify-content-between">
                <a class="text-white-50" asp-page="./ForgotPassword">Quên mật khẩu?</a>
                <a class="text-white-50" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                    Đăng ký tài khoản mới
                </a>
            </div>
        </form>
    </div>

    <!-- Separator -->
    <div class="login-separator"></div>

    <!-- OAuth -->
    <div class="text-center" style="max-width: 400px;">
        <h4 class="text-white mb-3">Hoặc đăng nhập với Google</h4>
        <a href="@Url.Action("GoogleLogin", "Auth")" title="Đăng nhập với Google">
            <img src="https://developers.google.com/identity/images/btn_google_signin_dark_normal_web.png"
                 alt="Đăng nhập với Google" />
        </a>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
