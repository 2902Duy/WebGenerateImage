@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<style>
    .form-container {
        background: rgba(0, 0, 0, 0.6);
    }

        .form-container .form-control {
            background: transparent;
            color: #fff;
            border: 1px solid #17c3b2;
        }

            .form-container .form-control::placeholder {
                color: rgba(255,255,255,0.6);
            }

        .form-container .form-floating label {
            color: rgba(255,255,255,0.6);
        }

    .btn-otp {
        color: #17c3b2;
        border-color: #17c3b2;
        background: transparent;
    }

        .btn-otp:hover {
            background: #17c3b2;
            color: #000;
        }

    .btn-register {
        background: #17c3b2;
        border-color: #17c3b2;
        color: #000;
    }

        .btn-register:hover {
            background: #13a79e;
        }
</style>

<h1 class="text-white text-center mb-4">@ViewData["Title"]</h1>

@if (TempData["OtpSent"] != null)
{
    <div class="alert alert-success text-center mb-4">
        @TempData["OtpSent"]
    </div>
}
<form id="registerForm"
      asp-route-returnUrl="@Model.ReturnUrl"
      method="post"
      class="mx-auto p-5 rounded-4 shadow form-container"
      style="max-width: 400px;">

    <h2 class="h5 text-white text-center mb-4">Tạo tài khoản mới</h2>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Email"
               class="form-control rounded-pill"
               autocomplete="username"
               placeholder="email@example.com" />
        <label asp-for="Input.Email">Email</label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Password"
               type="password"
               class="form-control rounded-pill"
               autocomplete="new-password"
               placeholder="Password"
               value="@(Model.Input?.Password ?? "")" />
        <label asp-for="Input.Password">Password</label>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Input.ConfirmPassword"
               type="password"
               class="form-control rounded-pill"
               autocomplete="new-password"
               placeholder="Confirm Password"
               value="@(Model.Input?.ConfirmPassword ?? "")" />
        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>


    <div class="form-floating mb-4">
        <input asp-for="Input.OtpCode"
               class="form-control rounded-pill"
               placeholder="Mã OTP" />
        <label asp-for="Input.OtpCode">Mã OTP</label>
        <span asp-validation-for="Input.OtpCode" class="text-danger"></span>
    </div>

    <div class="d-grid gap-2 mb-3">
        <button type="submit"
                formaction="/Identity/Account/Register?handler=SendOtp"
                formmethod="post"
                formnovalidate
                class="btn btn-outline-light btn-otp rounded-pill py-2">
            Gửi mã OTP
        </button>
    </div>


    <div class="d-grid">
        <button id="registerSubmit"
                type="submit"
                class="btn btn-register rounded-pill py-2">
            Đăng ký
        </button>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
