@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Nếu bạn đã tích hợp particles.js, phần này sẽ tạo hiệu ứng nền -->
<div id="particles-js" style="position: fixed; width: 100%; height: 100%; z-index: -1;"></div>

<!-- ================= HERO SECTION ================= -->
<section class="d-flex flex-column justify-content-center align-items-center text-center py-5" style="min-height: 90vh;">
    <h1 class="display-4 fw-bold" style="color: #8fff8f;">
        Tạo ảnh AI online miễn phí:<br />
        Biến văn bản thành hình ảnh
    </h1>

    <p class="lead text-light col-md-8 mt-4">
        Tạo ảnh AI trực tuyến trong vài giây với trình tạo hình ảnh miễn phí của chúng tôi.<br />
        Hãy để trí tưởng tượng của bạn biến thành nghệ thuật đáng kinh ngạc – không quảng cáo, không giới hạn.
    </p>

    <!-- ✅ Nút dẫn đến ImageController.Index (Views/Image/Index.cshtml) -->
    <a asp-controller="Image" asp-action="Index" class="btn btn-success btn-lg mt-4 px-4 py-2 fw-semibold">
        Tạo ảnh AI ngay bây giờ
    </a>
</section>

<!-- ================= AI TẠO RA CHO MỌI DỊP ================= -->
<section class="py-5 text-center text-white" style="background-color: #0a0a0a;">
    <div class="container">
        <h2 class="fw-bold mb-5">AI tạo ra cho mọi dịp</h2>
        <div class="row g-4">
            <!-- Card 1: Content Creator -->
            <div class="col-md-4">
                <div class="card h-100 bg-transparent border-0 text-center">
                    <img src="~/images/icons/content.png"
                         alt="Dành cho người sáng tạo nội dung"
                         class="mx-auto mb-3"
                         style="width:64px; height:64px;" />
                    <div class="card-body px-0">
                        <h5 class="card-title">Dành cho người sáng tạo nội dung</h5>
                        <p class="card-text text-light small">
                            Tạo ảnh bắt mắt từ văn bản hoặc thay đổi kiểu ảnh tham chiếu trong tay bạn và tạo nội dung nhanh hơn.
                        </p>
                    </div>
                </div>
            </div>
            <!-- Card 2: Doanh nghiệp -->
            <div class="col-md-4">
                <div class="card h-100 bg-transparent border-0 text-center">
                    <img src="~/images/icons/business.png"
                         alt="Dành cho doanh nghiệp"
                         class="mx-auto mb-3"
                         style="width:64px; height:64px;" />
                    <div class="card-body px-0">
                        <h5 class="card-title">Dành cho doanh nghiệp</h5>
                        <p class="card-text text-light small">
                            Chuyển đổi hình ảnh hoặc văn bản thành hình ảnh, biến ý tưởng của bạn thành thiết kế sản phẩm thực tế và tiết kiệm thời gian.
                        </p>
                    </div>
                </div>
            </div>
            <!-- Card 3: Nghệ sĩ -->
            <div class="col-md-4">
                <div class="card h-100 bg-transparent border-0 text-center">
                    <img src="~/images/icons/artist.png"
                         alt="Dành cho nghệ sĩ"
                         class="mx-auto mb-3"
                         style="width:64px; height:64px;" />
                    <div class="card-body px-0">
                        <h5 class="card-title">Dành cho nghệ sĩ</h5>
                        <p class="card-text text-light small">
                            Đắm chìm trong cảm hứng và đẩy nhanh quá trình sáng tác tác phẩm nghệ thuật của bạn như NFT, ASCII, OP, Cubism, Pixar, v.v.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= HƠN CẢ MỘT CÔNG CỤ ================= -->
<section class="py-5 text-center text-white" style="background-color: #000;">
    <div class="container">
        <h2 class="fw-bold mb-4">Hơn cả một công cụ tạo văn bản và hình ảnh thành hình ảnh</h2>
        <p class="text-light mb-5">Nâng cao chất lượng hình ảnh do AI tạo ra</p>
        <div class="row g-4">
            <!-- Feature 1: Làm mờ hình ảnh -->
            <div class="col-md-4">
                <div class="card h-100 border-0 bg-dark text-start shadow-sm">
                    <img src="~/images/features/blur-before.jpg"
                         class="card-img-top"
                         alt="Làm mờ hình ảnh – Before/After"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title text-white">Làm mờ hình ảnh</h5>
                        <p class="card-text text-light small">
                            Làm mờ và làm sắc nét ảnh bị mờ để nâng cao độ rõ nét và chi tiết của ảnh.
                        </p>
                    </div>
                </div>
            </div>
            <!-- Feature 2: Nâng cấp AI -->
            <div class="col-md-4">
                <div class="card h-100 border-0 bg-dark text-start shadow-sm">
                    <img src="~/images/features/upscale.jpg"
                         class="card-img-top"
                         alt="Nâng cấp AI – Low to High Res"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title text-white">Nâng cấp AI</h5>
                        <p class="card-text text-light small">
                            Nâng cao hình ảnh lên độ phân giải 4K và cải thiện chất lượng chỉ bằng một cú nhấp chuột.
                        </p>
                    </div>
                </div>
            </div>
            <!-- Feature 3: AI thay thế -->
            <div class="col-md-4">
                <div class="card h-100 border-0 bg-dark text-start shadow-sm">
                    <img src="~/images/features/replace.jpg"
                         class="card-img-top"
                         alt="AI thay thế – Change Elements"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title text-white">AI thay thế</h5>
                        <p class="card-text text-light small">
                            Thay thế khuôn mặt, nền, bầu trời và bất kỳ thủ tục khác để sử dụng chuyên nghiệp hoặc giải trí.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= CÁC CARD DANH MỤC ================= -->
<section class="py-5" style="background-color: #000;">
    <div class="container">
        <h2 class="text-white text-center mb-5 fw-bold">Trải nghiệm nhiều loại và phong cách ảnh</h2>
        <p class="text-center text-light mb-5">
            Tạo hình ảnh bằng AI trong Fotor và khám phá những khả năng vô tận. Có hàng nghìn phong cách ảnh và nghệ thuật.<br />
            Cho dù bạn muốn bắt chước phong cách của các nghệ sĩ nổi tiếng, tạo hình nền và hình minh họa, tham gia
            vào nghệ thuật hâm mộ cho các nhân vật anime và trò chơi hay thiết kế đồ trang trí nhà cửa và sản phẩm,
            Fotor đều đáp ứng nhu cầu của bạn.
        </p>

        <div class="row g-4">
            <!-- Card 1: Nghệ thuật NFT -->
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 bg-dark text-white shadow-sm">
                    <img src="~/images/categories/nft-art.jpg"
                         class="card-img-top"
                         alt="Nghệ thuật NFT"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Nghệ thuật NFT</h5>
                        <p class="card-text text-light small">
                            Biến tác phẩm nghệ thuật của bạn thành NFT phi thường theo phong cách của Van Gogh, Dadaism, v.v.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 2: Phong cảnh -->
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 bg-dark text-white shadow-sm">
                    <img src="~/images/categories/landscape.jpg"
                         class="card-img-top"
                         alt="Phong cảnh"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Phong cảnh</h5>
                        <p class="card-text text-light small">
                            Tạo ra những bức tranh phong cảnh hấp dẫn theo phong cách ấn tượng, siêu thực, tranh thủy mặc, v.v.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 3: Phim hoạt hình & Anime -->
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 bg-dark text-white shadow-sm">
                    <img src="~/images/categories/anime.jpg"
                         class="card-img-top"
                         alt="Phim hoạt hình & Anime"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Phim hoạt hình & Anime</h5>
                        <p class="card-text text-light small">
                            Biến hình ảnh thành phong cách hoạt hình của Disney, Makoto Shinkai, Miyazaki Hayao, v.v.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 4: Hình thu nhỏ & Bìa -->
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 bg-dark text-white shadow-sm">
                    <img src="~/images/categories/thumbnail.jpg"
                         class="card-img-top"
                         alt="Hình thu nhỏ & Bìa"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Hình thu nhỏ & Bìa</h5>
                        <p class="card-text text-light small">
                            Tạo và chỉnh sửa hình thu nhỏ, bìa video bắt mắt như nghệ thuật OP và ấn tượng.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 5: Nội thất & Kiến trúc -->
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 bg-dark text-white shadow-sm">
                    <img src="~/images/categories/interior.jpg"
                         class="card-img-top"
                         alt="Nội thất & Kiến trúc"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Nội thất & Kiến trúc</h5>
                        <p class="card-text text-light small">
                            Tạo phối cảnh nội thất sang trọng hoặc kiến trúc hiện đại – phù hợp thiết kế nội thất và quy hoạch đô thị.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 6: Chân dung nghệ thuật -->
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 bg-dark text-white shadow-sm">
                    <img src="~/images/categories/portrait.jpg"
                         class="card-img-top"
                         alt="Chân dung nghệ thuật"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Chân dung nghệ thuật</h5>
                        <p class="card-text text-light small">
                            Biến ảnh chân dung thành tranh sơn dầu, tranh acrylic hoặc phác thảo chì đầy nghệ thuật.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 7: Thực phẩm & Thức uống -->
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 bg-dark text-white shadow-sm">
                    <img src="~/images/categories/food.jpg"
                         class="card-img-top"
                         alt="Thực phẩm & Thức uống"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Thực phẩm & Thức uống</h5>
                        <p class="card-text text-light small">
                            Tạo hình ảnh món ăn, đồ uống theo phong cách quảng cáo chuyên nghiệp, ẩm thực sang trọng.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 8: Logo & Nhãn hiệu -->
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 bg-dark text-white shadow-sm">
                    <img src="~/images/categories/logo1.jpg"
                         class="card-img-top"
                         alt="Logo & Nhãn hiệu"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Logo & Nhãn hiệu</h5>
                        <p class="card-text text-light small">
                            Tạo và chỉnh sửa logo/nhãn hiệu – phù hợp cho thương hiệu, bản quyền hoặc dự án cá nhân.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- Nếu bạn đang dùng particles.js -->
    <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
    <script>
        particlesJS("particles-js", {
            particles: {
                number: { value: 60 },
                color: { value: "#00ffcc" },
                shape: { type: "circle" },
                opacity: { value: 0.5 },
                size: { value: 3 },
                line_linked: {
                    enable: true,
                    distance: 150,
                    color: "#00ffcc",
                    opacity: 0.4,
                    width: 1
                },
                move: {
                    enable: true,
                    speed: 1.5,
                    direction: "none",
                    out_mode: "out"
                }
            },
            interactivity: {
                events: {
                    onhover: { enable: true, mode: "grab" }
                },
                modes: {
                    grab: { distance: 200, line_linked: { opacity: 0.6 } }
                }
            },
            retina_detect: true
        });
    </script>
}