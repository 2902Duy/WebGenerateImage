<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - AIImageWeb</title>

    <!-- Bootstrap + custom dark mode -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />

    <style>
        body {
            background-color: #000;
            color: #fff;
            font-family: 'Poppins', sans-serif;
        }

        a, .text-primary, .btn-link {
            color: #0dcaf0;
        }

        .form-control {
            background-color: #1a1a1a;
            color: white;
            border: 1px solid #444;
        }

            .form-control::placeholder {
                color: #888;
            }

        .card {
            background-color: #1e1e1e;
            color: white;
            border: 1px solid #333;
            transition: transform 0.3s ease;
        }

            .card:hover {
                transform: scale(1.03);
                box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
            }

        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

            .btn-primary:hover {
                background-color: #0b5ed7;
            }

        .btn-success {
            background-color: #198754;
            border-color: #198754;
        }

        .nav-link {
            color: white;
            text-decoration: none;
            margin-left: 1rem;
        }

            .nav-link:hover {
                color: #0dcaf0;
            }
    </style>
</head>
<body>
    <header class="d-flex justify-content-between align-items-center p-3 bg-dark text-white">
        <div class="d-flex align-items-center">
            <img src="/images/imageweb/logo.jpg" alt="Logo" style="height: 40px; margin-right: 10px;">
            <span class="fs-4 fw-bold">AIImageWeb</span>
        </div>
        <nav class="d-flex align-items-center">
            <a href="/" class="nav-link">Trang chủ</a>
            <a href="/image" class="nav-link">Tạo ảnh từ AI</a>
            <a href="/Image/MyLibrary" class="nav-link">Thư viện</a>
            <a asp-area="Identity" asp-page="/Account/Login" class="nav-link">Đăng nhập</a>

        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="text-center py-3 border-top">
        &copy; 2025 - AIImageWeb
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
