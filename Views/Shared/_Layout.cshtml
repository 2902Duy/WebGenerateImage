<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - AIImageWeb</title>

    <!-- Bootstrap + custom dark mode -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />

    <style>
        body {
            background-color: #000;
            color: #fff;
            font-family: 'Poppins', sans-serif;
        }

        a, .text-primary, .btn-link {
            color: #0dcaf0;
        }

        .form-control {
            background-color: #1a1a1a;
            color: white;
            border: 1px solid #444;
        }

            .form-control::placeholder {
                color: #888;
            }

        .card {
            background-color: #1e1e1e;
            color: white;
            border: 1px solid #333;
            transition: transform 0.3s ease;
        }

            .card:hover {
                transform: scale(1.03);
                box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
            }

        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

            .btn-primary:hover {
                background-color: #0b5ed7;
            }

        .btn-success {
            background-color: #198754;
            border-color: #198754;
        }

        /* Particles background container */
        #particles-js {
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: -1;
        }
    </style>
</head>
<body>
    <!-- Particles.js nền -->
    <div id="particles-js"></div>

    <!-- Header responsive -->
    <header style="position: relative; z-index: 2;">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="/images/imageweb/logo.jpg" alt="Logo" style="height: 40px; margin-right: 10px;">
                <span class="fs-5 fw-bold">AIImageWeb</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a href="/" class="nav-link">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a href="/image" class="nav-link">Tạo ảnh từ AI</a>
                    </li>
                    <li class="nav-item">
                        <a href="/Image/MyLibrary" class="nav-link">Thư viện</a>
                    </li>
                    <li class="nav-item">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="mt-4 text-light">
                                <p>👋 Xin chào, <strong>@User.Identity.Name</strong></p>
                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm mt-2">Đăng xuất</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <!-- Nút đăng nhập -->
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg mt-3 px-4 py-2 fw-semibold">
                                Đăng nhập
                            </a>
                        }
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <!-- Nội dung chính -->
    <main class="container py-4" style="position: relative; z-index: 1;">
        @RenderBody()
    </main>

    <footer class="text-center py-3 border-top" style="position: relative; z-index: 1;">
        &copy; 2025 - AIImageWeb
    </footer>

    <!-- ParticlesJS -->
    <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
    <script>
        particlesJS.load('particles-js', '/js/particles.json', function () {
            console.log('Particles.js config loaded.');
        });
    </script>

    <!-- Bootstrap JS (required for menu toggle) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
