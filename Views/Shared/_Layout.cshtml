@using Microsoft.AspNetCore.Mvc.Controllers
@{
    var routeDescriptor = ViewContext.ActionDescriptor as ControllerActionDescriptor;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Image Creation Website</title>

    <!-- Bootstrap + Fonts + Icons -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background-color: #000;
            color: #fff;
        }

        /* ===== HERO SECTION ===== */
        .hero-section {
            position: relative;
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .slideshow-container, #particles-js {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        .slide {
            position: absolute;
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
        }

            .slide.active {
                opacity: 1;
            }

        .hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
        }

            .hero-content h1 {
                font-size: 2.5rem;
                font-weight: bold;
                color: #9f6;
            }

            .hero-content p {
                font-size: 1.2rem;
                color: #eee;
            }

        /* ===== NAVBAR ===== */
        .overlay-header {
            position: absolute;
            top: 0;
            width: 100%;
            z-index: 10;
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        }

        .navbar .nav-link {
            color: #fff !important;
        }

            .navbar .nav-link:hover {
                color: #0ff !important;
            }

        /* ===== MAIN CONTENT ===== */
        main {
            position: relative;
            z-index: 1;
            padding: 3rem 1rem;
        }

        footer {
            text-align: center;
            padding: 1rem;
            border-top: 1px solid #333;
        }

        .btn-primary {
            background-color: #198754;
            border: none;
        }

            .btn-primary:hover {
                background-color: #157347;
            }
    </style>
</head>
<body>
    <!-- ===== HERO SECTION with NAVBAR inside ===== -->
    @if (routeDescriptor != null && routeDescriptor.ControllerName == "Home" && routeDescriptor.ActionName == "Index")
    {
        <section class="hero-section">
            <!-- Slideshow background -->
            <div class="slideshow-container">
                <div class="slide" style="background-image: url('/images/backgrounds/bg1.jpeg');"></div>
                <div class="slide" style="background-image: url('/images/backgrounds/bg2.jpeg');"></div>
                <div class="slide" style="background-image: url('/images/backgrounds/bg3.jpeg');"></div>
            </div>

            <!-- Particles background -->
            <div id="particles-js"></div>

            <!-- Navbar Overlay -->
            <header class="overlay-header">
                <nav class="navbar navbar-expand-lg navbar-dark">
                    <div class="container-fluid px-4">
                        <a class="navbar-brand d-flex align-items-center" href="/">
                            <img src="/images/imageweb/icons8-ai-generated-image-48.png" alt="Logo" height="40" class="me-2" />
                            <span class="fw-bold">ImageCreation</span>
                        </a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="mainNavbar">
                            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                <li class="nav-item">
                                    <a href="/" class="nav-link @(Context.Request.Path == "/" ? "active" : "")">
                                        <i class="fas fa-home me-1"></i> Trang chủ
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/image" class="nav-link @(Context.Request.Path.StartsWithSegments("/image") ? "active" : "")">
                                        <i class="fas fa-magic me-1"></i> Tạo ảnh từ AI
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/Image/MyLibrary" class="nav-link @(Context.Request.Path.StartsWithSegments("/Image/MyLibrary") ? "active" : "")">
                                        <i class="fas fa-images me-1"></i> Thư viện
                                    </a>
                                </li>
                            </ul>
                            <div class="d-flex align-items-center">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <div class="dropdown">
                                        <a class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
                                           href="#" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-person-circle fs-4 me-1"></i>
                                            <span>@User.Identity.Name</span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                            <li>
                                                <a class="dropdown-item d-flex align-items-center"
                                                   asp-area="Identity" asp-page="/Account/Manage/Index">
                                                    <i class="bi bi-gear me-2"></i> Hồ sơ của tôi
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="px-3 py-2">
                                                    <button type="submit" class="btn btn-outline-danger w-100">
                                                        Đăng xuất
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary ms-3 px-4 py-2">
                                        Đăng nhập
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </nav>
            </header>

            <!-- Hero nội dung chính -->
            <div class="hero-content text-center text-white">
                <h1>Tạo ảnh AI online miễn phí:<br />Biến văn bản thành hình ảnh</h1>
                <p class="mt-3">Trực tuyến trong vài giây – không quảng cáo, không giới hạn!</p>
                <div class="mt-4 d-flex justify-content-center gap-3">
                    <!-- Nút nền đầy màu xanh lá -->
                    <a asp-controller="Image" asp-action="Index"
                       class="btn btn-success btn-lg">
                        Tạo ảnh từ AI
                    </a>
                    <!-- Nút outline cùng tông xanh lá -->
                    <a asp-controller="Image" asp-action="Upload"
                       class="btn btn-success btn-lg">
                        Sáng tạo ảnh AI với chúng tôi
                    </a>
                </div>
            </div>
        </section>
    }
    else
    {
        <!-- Phần khác trang chủ: chỉ hiển thị particles và navbar -->
        <div id="particles-js"></div>
        <header class="overlay-header">
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <div class="container-fluid px-4">
                    <a class="navbar-brand d-flex align-items-center" href="/">
                        <img src="/images/imageweb/icons8-ai-generated-image-48.png" alt="Logo" height="40" class="me-2" />
                        <span class="fw-bold">ImageCreation</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a href="/" class="nav-link @(Context.Request.Path == "/" ? "active" : "")">
                                    <i class="fas fa-home me-1"></i> Trang chủ
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="/image" class="nav-link @(Context.Request.Path.StartsWithSegments("/image") ? "active" : "")">
                                    <i class="fas fa-magic me-1"></i> Tạo ảnh từ AI
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="/Image/MyLibrary" class="nav-link @(Context.Request.Path.StartsWithSegments("/Image/MyLibrary") ? "active" : "")">
                                    <i class="fas fa-images me-1"></i> Thư viện
                                </a>
                            </li>
                        </ul>
                        <div class="d-flex align-items-center">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <div class="dropdown">
                                    <a class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
                                       href="#" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle fs-4 me-1"></i>
                                        <span>@User.Identity.Name</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center"
                                               asp-area="Identity" asp-page="/Account/Manage/Index">
                                                <i class="bi bi-gear me-2"></i> Hồ sơ của tôi
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="px-3 py-2">
                                                <button type="submit" class="btn btn-outline-danger w-100">
                                                    Đăng xuất
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary ms-3 px-4 py-2">
                                    Đăng nhập
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }


    <!-- ===== MAIN CONTENT (không bị ảnh hưởng nền) ===== -->
    <main class="container">
        @RenderBody()
    </main>

    <footer>&copy; 2025 - ImageCreation</footer>

    <!-- JS Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
    <script>
        particlesJS.load('particles-js', '/js/particles.json', function () {
            console.log("Particles loaded");
        });

        // Slideshow logic
        let slideIndex = 0;
        const slides = document.querySelectorAll(".slide");

        function showSlides() {
            slides.forEach(s => s.classList.remove("active"));
            slideIndex = (slideIndex + 1) % slides.length;
            slides[slideIndex].classList.add("active");
        }

        slides[0].classList.add("active");
        setInterval(showSlides, 6000);
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
