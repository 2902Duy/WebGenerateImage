@model string
@{
    ViewData["Title"] = "Xác nhận xóa ảnh";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-white shadow-sm">
                <div class="card-header text-center">
                    <h3 class="mb-0">Bạn có chắc muốn xóa ảnh này?</h3>
                </div>
                <div class="card-body text-center">
                    <img src="@Model"
                         alt="Ảnh cần xóa"
                         class="img-fluid rounded mb-4"
                         style="max-height:300px; object-fit:contain; border:1px solid #444;" />
                    <form asp-controller="Image" asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="imageUrl" value="@Model" />
                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit"
                                    class="btn btn-danger px-4 py-2">
                                <i class="bi bi-trash me-1"></i> Xóa
                            </button>
                            <a asp-action="MyLibrary"
                               class="btn btn-secondary px-4 py-2">
                                Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
