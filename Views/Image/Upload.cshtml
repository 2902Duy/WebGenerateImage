@{
    ViewData["Title"] = "Upload Image";

}

<h2>Upload ảnh để tạo lại bằng Stable Diffusion</h2>

<form asp-controller="Image" asp-action="Transformation" method="post" enctype="multipart/form-data">

    <div>
        <label>Chọn ảnh:</label><br />
        <input type="file" name="initImage" accept="image/*" required />
    </div>
    <div>
        <label>Image Strength: <span id="strengthValue">0.35</span></label><br />
        <input type="range" name="imageStrength" id="imageStrength" min="0.1" max="1.0" step="0.01" value="0.35"
               oninput="document.getElementById('strengthValue').innerText = this.value" />
    </div>
    <button type="submit">Tạo ảnh</button>
</form>
