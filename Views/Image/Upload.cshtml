@{
    ViewData["Title"] = "Upload Image";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card bg-dark text-white shadow-lg">
                <div class="card-header border-0 text-center">
                    <h3 class="mb-0">Tạo ảnh mới từ ảnh upload</h3>
                </div>
                <div class="card-body">
                    <form asp-controller="Image" asp-action="Transformation" method="post" enctype="multipart/form-data">
                        @if (ViewBag.ExistingImage != null)
                        {
                            <input type="hidden" name="existingImagePath" value="@ViewBag.ExistingImage" />
                        }

                        <div class="row g-4">
                            <!-- File input -->
                            @if (ViewBag.ExistingImage == null)
                            {
                                <div class="col-md-6">
                                    <label for="initImage" class="form-label">Chọn ảnh nguồn</label>
                                    <input type="file"
                                           id="initImage"
                                           name="initImage"
                                           accept="image/*"
                                           class="form-control form-control-dark"
                                           onchange="previewImage(event)"
                                           required />
                                </div>
                            }

                            <!-- Preview ảnh -->
                            <div class="@(ViewBag.ExistingImage == null ? "col-md-6" : "col-md-12") text-center">
                                <img id="preview"
                                     src=""
                                     alt="Preview"
                                     class="img-fluid rounded border d-none"
                                     style="max-height: 200px; object-fit: contain;" />
                            </div>

                            <!-- Slider chỉnh hiệu ứng -->
                            <div class="col-12">
                                <label for="imageStrength" class="form-label">
                                    Độ mạnh hiệu ứng: <strong><span id="strengthValue">0.35</span></strong>
                                </label>
                                <input type="range"
                                       id="imageStrength"
                                       name="imageStrength"
                                       class="form-range"
                                       min="0.1"
                                       max="1.0"
                                       step="0.01"
                                       value="0.35"
                                       oninput="document.getElementById('strengthValue').innerText = this.value" />
                            </div>

                            <!-- Nút tạo ảnh -->
                            <div class="col-12 text-center">
                                <button type="submit"
                                        class="btn btn-success btn-lg px-5 py-2">
                                    <i class="bi bi-image me-2"></i>
                                    Tạo ảnh
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function previewImage(event) {
            const [file] = event.target.files;
            const img = document.getElementById('preview');
            if (file) {
                img.src = URL.createObjectURL(file);
                img.classList.remove('d-none');
            } else {
                img.src = '';
                img.classList.add('d-none');
            }
        }

        @if (ViewBag.ExistingImage != null)
        {
                <text>
                window.addEventListener('DOMContentLoaded', () => {
                    const img = document.getElementById('preview');
                    img.src = '@ViewBag.ExistingImage';
                    img.classList.remove('d-none');
                });
                </text>
        }
    </script>
}
