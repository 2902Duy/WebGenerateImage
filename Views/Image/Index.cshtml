@model WebGenerateImage.Models.ImagePrompt
@using DotNetEnv
@{
    ViewData["Title"] = "Tạo ảnh từ AI";
    ViewBag.GOOGLE_TRANSLATE_API = Environment.GetEnvironmentVariable("GOOGLE_TRANSLATE_API");
}

