@model WebGenerateImage.Models.ImagePrompt
@using DotNetEnv

@{
    ViewData["Title"] = "Tạo ảnh từ AI";
    ViewBag.GOOGLE_TRANSLATE_API = Environment.GetEnvironmentVariable("GOOGLE_TRANSLATE_API");
}

<section class="container py-5">
    <div class="row gx-5 gy-4">
        <!-- Form chính -->
        <div class="col-lg-8">
            <div class="card bg-dark border-0 shadow-lg rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <h2 class="text-success fw-bold mb-2">
                            <i class="bi bi-stars me-2"></i>
                            Tạo ảnh với trí tuệ nhân tạo
                        </h2>
                        <p class="text-secondary fst-italic">Hãy mô tả thật sinh động để AI hiểu bạn đang tưởng tượng điều gì!</p>
                    </div>

                    <form id="generateForm" method="post" asp-controller="Image" asp-action="Generate">
                        <div class="mb-4">
                            <label for="prompt" class="form-label text-white fw-semibold">Mô tả ý tưởng bằng tiếng Việt</label>
                            <textarea class="form-control form-control-lg rounded-4"
                                      name="Prompt"
                                      id="prompt"
                                      rows="5"
                                      placeholder="Ví dụ: Một con mèo đang bay trong không gian, nền tối, ánh sáng neon xanh...">@Model?.Prompt</textarea>
                            <span asp-validation-for="Prompt" class="text-danger mt-2 d-block"></span>
                        </div>

                        <div class="d-grid">
                            <button id="submitBtn" type="submit" class="btn btn-success btn-lg rounded-pill shadow">
                                <i class="bi bi-rocket-takeoff-fill me-2"></i> Tạo ảnh ngay
                            </button>
                        </div>
                    </form>

                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger mt-4" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> Vui lòng kiểm tra lại thông tin vừa nhập.
                        </div>
                    }
                </div>
            </div>

            <!-- Accordion Tips -->
            <div class="accordion mt-5 rounded-4 overflow-hidden" id="tipsAccordion">
                <div class="accordion-item bg-dark text-white border border-secondary">
                    <h2 class="accordion-header" id="headingTips">
                        <button class="accordion-button collapsed bg-dark text-white fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTips" aria-expanded="false" aria-controls="collapseTips">
                            <i class="bi bi-lightbulb me-2"></i> Mẹo để viết prompt ấn tượng
                        </button>
                    </h2>
                    <div id="collapseTips" class="accordion-collapse collapse" aria-labelledby="headingTips" data-bs-parent="#tipsAccordion">
                        <div class="accordion-body">
                            <ul class="mb-0">
                                <li><strong>Phong cách:</strong> ví dụ <em>cyberpunk</em>, <em>tranh sơn dầu</em></li>
                                <li><strong>Chi tiết:</strong> ánh sáng, màu sắc, góc nhìn</li>
                                <li><strong>Bối cảnh/cảm xúc:</strong> ví dụ <em>mùa đông buồn</em>, <em>huyền bí</em></li>
                                <li><strong>Hạn chế noise:</strong> tránh mô tả quá dài dòng</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar: Ví dụ prompt -->
        <div class="col-lg-4">
            <div class="card bg-dark border-0 shadow-lg rounded-4 h-100">
                <div class="card-header bg-secondary text-white fw-bold">
                    <i class="bi bi-lightning-charge me-2"></i>
                    Prompt mẫu siêu nhanh
                </div>
                <div class="card-body p-3">
                    <div class="row row-cols-1 row-cols-md-2 g-3 mb-3">
                        <div class="col">
                            <button type="button"
                                    class="btn btn-outline-info w-100 rounded-pill prompt-example"
                                    data-prompt="Chân dung nữ hacker trong phòng neon cyberpunk">
                                🎯 Hacker neon
                            </button>
                        </div>
                        <div class="col">
                            <button type="button"
                                    class="btn btn-outline-info w-100 rounded-pill prompt-example"
                                    data-prompt="Phong cảnh núi non hùng vĩ dưới bình minh">
                                🌄 Núi bình minh
                            </button>
                        </div>
                        <div class="col">
                            <button type="button"
                                    class="btn btn-outline-info w-100 rounded-pill prompt-example"
                                    data-prompt="Thiết kế poster concert ban nhạc rock retro">
                                🎸 Poster rock
                            </button>
                        </div>
                        <div class="col">
                            <button type="button"
                                    class="btn btn-outline-info w-100 rounded-pill prompt-example"
                                    data-prompt="Nền vũ trụ với các hành tinh màu tím và sao băng">
                                🪐 Vũ trụ tím
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</section>

@section Scripts {
    <script>
                // Spinner khi submit
                document.getElementById("generateForm").addEventListener("submit", function () {
                    var btn = document.getElementById("submitBtn");
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang tạo...';
                });

                // Điền prompt mẫu
                document.querySelectorAll(".prompt-example").forEach(function (btn) {
                    btn.addEventListener("click", function () {
                        document.getElementById("prompt").value = this.getAttribute("data-prompt");
        window.scrollTo({ top: 0, behavior: 'smooth' });
                    });
                });
    </script>
}