@model WebGenerateImage.Models.ImagePrompt
@{
    ViewData["Title"] = "Tạo ảnh từ AI";
}

<section class="container py-5 text-center">
    <h2 class="text-success mb-4">🧠 Nhập mô tả để tạo ảnh bằng AI</h2>

    <form method="post" asp-controller="Image" asp-action="Generate" class="mx-auto" style="max-width: 700px;">
        <div class="mb-3">
            <textarea class="form-control" name="Prompt" rows="4" placeholder="Ví dụ: Một con mèo đang bay trong không gian...">@Model?.Prompt</textarea>
            <span asp-validation-for="Prompt" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-success btn-lg px-5">Tạo ảnh</button>
    </form>
</section>
