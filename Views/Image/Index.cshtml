@model WebGenerateImage.Models.ImagePrompt
@using DotNetEnv
@{
    ViewData["Title"] = "Tạo ảnh từ AI";
    ViewBag.GOOGLE_TRANSLATE_API = Environment.GetEnvironmentVariable("GOOGLE_TRANSLATE_API");
}

@section Scripts {
@* Nếu cần bật chức năng dịch tự động, có thể giải nén đoạn script bên dưới *@
@*
        <script>
            document.querySelector('form').addEventListener('submit', async function (e) {
                e.preventDefault();
                const originalText = document.querySelector('#prompt').value.trim();
                const hiddenInput = document.querySelector('#translated-prompt');

                const url_trans = '@ViewBag.GOOGLE_TRANSLATE_API';
                const url = url_trans + `?client=gtx&sl=vi&tl=en&dt=t&q=${encodeURIComponent(originalText)}`;
                console.log("Translating text:", url);

                try {
                    const response = await fetch(url);
                    const data = await response.json();
                    const translated = data[0][0][0];

                    hiddenInput.value = translated;
                    this.submit();
                } catch (error) {
                    alert("Lỗi dịch tự động. Vui lòng thử lại.");
                    console.error(error);
                }
            });
        </script>
        *@
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card bg-dark border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h2 class="text-success">
                            <i class="bi bi-image-fill me-2"></i>
                            Nhập mô tả để tạo ảnh bằng AI
                        </h2>
                        <p class="text-muted">Viết chi tiết giúp AI hiểu rõ ý tưởng của bạn.</p>
                    </div>

                    <form method="post" asp-controller="Image" asp-action="Generate">
                        <div class="mb-3">
                            <label for="prompt" class="form-label text-white fw-semibold">Mô tả (Tiếng Việt)</label>
                            <textarea class="form-control form-control-lg"
                                      name="Prompt"
                                      id="prompt"
                                      rows="5"
                                      placeholder="Ví dụ: Một con mèo đang bay trong không gian, nền tối, ánh sáng neon xanh...">@Model?.Prompt</textarea>
                            <span asp-validation-for="Prompt" class="text-danger mt-1 d-block"></span>
                        </div>

                        @* Nếu bật dịch tự động, mở comment và dùng dòng hidden này *@
                        @* <input type="hidden" name="Prompt" id="translated-prompt" /> *@

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill">
                                <i class="bi bi-rocket-takeoff-fill me-2"></i> Tạo ảnh ngay
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            @* Khu vực hiển thị lỗi chung nếu có *@
            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger bg-opacity-10 border-danger text-danger mt-3" role="alert">
                    Vui lòng kiểm tra lại thông tin vừa nhập.
                </div>
            }
        </div>
    </div>
</section>
