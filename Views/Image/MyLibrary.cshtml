@model IEnumerable<string>
@{
    ViewData["Title"] = "Thư viện ảnh";
}

<section class="container py-5">
    <h2 class="mb-4 text-center text-white">@ViewData["Title"]</h2>
    <div class="row g-4">
        @foreach (var url in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card bg-dark text-white h-100 shadow-sm">
                    <img src="@url"
                         class="card-img-top img-fluid"
                         alt="Ảnh mẫu"
                         style="object-fit: cover; height: 200px;" />
                    <div class="card-body d-flex justify-content-center gap-2">
                        <a href="@url"
                           download
                           class="btn btn-primary btn-sm d-flex align-items-center">
                            <i class="bi bi-download me-1"></i> Lưu
                        </a>
                        <form asp-controller="Image"
                              asp-action="Delete"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="imageUrl" value="@url" />
                            <button type="submit"
                                    class="btn btn-danger btn-sm d-flex align-items-center"
                                    onclick="return confirm('Bạn có chắc muốn xóa ảnh này không?');">
                                <i class="bi bi-trash me-1"></i> Xóa
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
